# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing key for DramaKhana session tokens
JWT_SECRET="dramakhana-dev-secret-change-in-production"

# MONGODB_URI: Optional MongoDB connection string (falls back to persistent local SQLite if omitted)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.ssmpl.mongodb.net/dramakhana?retryWrites=true&w=majority"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for playlist/video metadata enrichment
YOUTUBE_API_KEY=""

# CLOUDINARY_URL: Optional Cloudinary credentials for remote video storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
